# comma-separated, any number. Any OpenAI-compatible provider works.
LLM_KEYS=gsk_key1,gsk_key2,gsk_key3
LLM_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
SEC_UA=Your Name your@email.com
DATABASE_URL=sqlite:///quant.db
# postgresql+psycopg2://user:pass@localhost/alphadesk
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
WATCHLIST=AAPL,NVDA,NSE:RELIANCE,NSE:TCS,BSE:500325
# Bloomberg Desktop API (terminal must be logged in on THIS machine). Default is yahoo.
DATA_SOURCE=yahoo
BBG_HOST=localhost
BBG_PORT=8194
# update to current policy rates
RISK_FREE_USD=0.045
RISK_FREE_INR=0.065
